GraphicsWindow.Width = 225
GraphicsWindow.Height = 310

'Color de fondo
GraphicsWindow.BackgroundColor = "Black"

'Borde del teclado
GraphicsWindow.PenColor = "white"
GraphicsWindow.DrawRectangle(35,90,160,205)

'Borde exterior
GraphicsWindow.DrawRectangle(15,15,200,295)

'Boton de maximizar
GraphicsWindow.CanResize= "no"

'Caja de números
caja = Controls.AddTextBox(35,50)

'Agregar botones

punto = Controls.AddButton(".",50,260)
cero = Controls.AddButton("0",70,260)
uno = Controls.AddButton("1",50,220)
dos = Controls.AddButton("2",70,220)
tres = Controls.AddButton("3",90,220)
cuatro = Controls.AddButton("4",50,180)
cinco = Controls.AddButton("5",70,180)
seis = Controls.AddButton("6",90,180)
siete = Controls.AddButton("7",50,140)
ocho = Controls.AddButton("8",70,140)
nueve = Controls.AddButton("1",90,140)
suma = Controls.AddButton("+",110,140)
resta = Controls.AddButton("-",110,180)
multiplicacion = Controls.AddButton("*",110,220)
divison = Controls.AddButton("/",110,260)
igual = Controls.AddButton("=",90,260)


'Condiciones del boton
Sub boton
  ultimo_boton = Controls.LastClickedButton
EndSub

'Boton para borrar numeros
limpiar = Controls.AddButton("C",60,260)

'Evento del Boton
Controls.ButtonClicked = boton

'Variable auxiliar para saber cual operador usamos

operadorSuma = 0
operadorResta = 0
operadorMultiplica = 0
operadorDivide = 0

'Condicion del Boton

Sub boton
  ultimo_boton = Controls.LastClickedButton
  If ultimo_boton = uno Then
    boton1()
  ElseIf ultimo_boton = dos then
    boton2()
  EndIf
EndSub

'Subrutinas del boton numerico

Sub boton0
  contenido_caja = Controls.GetTextBoxText(caja)
  numero ="0"
  Controls.SetTextBoxText(caja,Text.Append(contenido_caja,numero))
EndSub

